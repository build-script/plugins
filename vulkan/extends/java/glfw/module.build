// a Java program that draws a triangle with Vulkan into a window of GLFW, through LWJGL
{{build.identifier}}_shaders = build_shaders("{{build.name}}-shaders", list("shaders/*.vert", "shaders/*.frag"), embed = false)

build_java("{{build.name}}", list(vulkan()) + lwjgl("glfw") + {{build.identifier}}_shaders, main_class = "{{build.package}}.Main")
